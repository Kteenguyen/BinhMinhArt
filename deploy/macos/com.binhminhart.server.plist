<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.binhminhart.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/mac/.nodejs/bin/node</string>
        <string>/Users/mac/Documents/antigravity/BinhMinhArt/server/index.js</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>WorkingDirectory</key>
    <string>/Users/mac/Documents/antigravity/BinhMinhArt</string>
    <key>StandardOutPath</key>
    <string>/Users/mac/Documents/antigravity/BinhMinhArt/data/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mac/Documents/antigravity/BinhMinhArt/data/server_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/mac/.nodejs/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PORT</key>
        <string>5001</string>
    </dict>
</dict>
</plist>
